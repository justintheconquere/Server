# Copy to .env on the box and fill in. Never commit the real .env.
# Each secret: openssl rand -hex 32
DB_PASSWORD=<generate>
JWT_SECRET=<generate>
COOKIE_SECRET=<generate>
# Optional: CORS origins once the storefront exists / if the admin
# is reached under a different name.
# STORE_CORS=http://localhost:8000
# ADMIN_CORS=http://ufo:9000
# AUTH_CORS=http://ufo:9000
