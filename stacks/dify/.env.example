# Copy to .env on the box and fill in. Never commit the real .env.
# Every value: openssl rand -hex 32 (DB/Redis passwords can be hex 24).
SECRET_KEY=<generate>
DB_PASSWORD=<generate>
REDIS_PASSWORD=<generate>
WEAVIATE_API_KEY=<generate>
SANDBOX_API_KEY=<generate>
PLUGIN_DAEMON_KEY=<generate>
INNER_API_KEY_FOR_PLUGIN=<generate>
