# Copy to .env on the box and fill in. Never commit the real .env.
MONERO_RPC_USER=monero
# Generate: openssl rand -hex 24
MONERO_RPC_PASS=
# Pruning is ON via the bare --prune-blockchain flag in docker-compose.yml
# (~105 GiB). For a full archival node (~265 GiB), remove that flag and
# delete ./data before starting.
# GUI wallet desktop (port 3006) basic auth. The PASSWORD must be set to
# something strong — that login guards a desktop holding wallet keys.
WALLET_GUI_USER=justin
WALLET_GUI_PASSWORD=
