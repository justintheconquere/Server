# Copy to .env on the box. Never commit the real .env.
# The name your directory bot shows in SimpleX Chat.
DIRECTORY_NAME=ufo Directory
# Superusers, format id:name (comma-separated for several). You only
# learn your profile's ID during the interactive first run (see
# README.md) — leave blank until then, fill in, restart the stack.
DIRECTORY_SUPERUSERS=
