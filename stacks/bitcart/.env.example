# Copy to .env on the box and fill in. Never commit the real .env.
# Generate each: openssl rand -hex 32
DB_PASSWORD=
XMR_DAEMON_PASSWORD=
# Bitcart's internal XMR daemon JSON-RPC port (not the node's 18081).
XMR_DAEMON_PORT=18083
# The shared node's RPC login — must match stacks/monerod/.env exactly.
MONERO_RPC_USER=monero
MONERO_RPC_PASS=
