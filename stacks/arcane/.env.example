# Copy to .env on the box and fill in. Never commit the real .env.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=
# Absolute path of this repo's stacks folder on the box, e.g. /home/justin/server-config/stacks
STACKS_DIR=
# uid/gid Arcane runs as — match the owner of the stacks folder.
PUID=1000
PGID=1000
