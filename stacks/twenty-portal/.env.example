# Copy to .env on the box and fill in. Never commit the real .env.
# Generate each: openssl rand -hex 32
PORTAL_DB_PASSWORD=
NEXTAUTH_SECRET=
# From Twenty: Settings → Developers → API key. Server-side only.
TWENTY_API_KEY=
# The portal's public URL once it has one (leave the placeholder while piloting).
NEXTAUTH_URL=https://portal.example.com
