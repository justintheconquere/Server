# Copy to .env on the box and fill in. Never commit the real .env.

# Password for the stack's own Postgres (n8n workflow data lives there).
POSTGRES_PASSWORD=<generate: openssl rand -hex 24>

# Encrypts every credential n8n stores (Gmail, APIs, webhooks...).
# Generate ONCE and keep it forever — if this key is lost or changed,
# all credentials stored in n8n become unreadable.
N8N_ENCRYPTION_KEY=<generate: openssl rand -hex 32>
