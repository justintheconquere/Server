# Copy to .env on the box and fill in. Never commit the real .env.
# !!! The WireGuard private key goes here, on the box only. !!!
VPN_SERVICE_PROVIDER=custom
WIREGUARD_PRIVATE_KEY=
# Your WireGuard interface address from your provider, e.g. 10.64.0.2/32
WIREGUARD_ADDRESSES=
# Only for named providers (VPN_SERVICE_PROVIDER != custom):
SERVER_COUNTRIES=
