# Copy to .env on the box and fill in. Never commit the real .env.
HTTP_WEB_PORT=8040
POZNOTE_MCP_PORT=8045
POZNOTE_USER_ID=1
# Bearer token for the MCP server — generate: openssl rand -hex 32
# Give it to Muse once after deploy so the Poznote connector can connect.
POZNOTE_MCP_AUTH_TOKEN=
POZNOTE_DEBUG=false
