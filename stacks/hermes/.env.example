# Copy to .env on the box and fill in. Never commit the real .env.
#
# These are the STACK's secrets only. Hermes' own provider keys (model
# providers, Telegram/Discord/etc.) are NOT here — the one-time setup
# wizard writes them into ./data/.env on the box.

# Key for Hermes' gateway API on :8642. Anything with this key can drive
# the agent — treat it like a password.
API_SERVER_KEY=<generate: openssl rand -hex 32>

# Dashboard (:9119) login. Hermes will not serve the dashboard without
# an auth provider configured — these satisfy it.
DASHBOARD_USER=justin
DASHBOARD_PASSWORD=<choose a strong password>

# Keeps dashboard sessions valid across container restarts.
DASHBOARD_SECRET=<generate: openssl rand -hex 32>
